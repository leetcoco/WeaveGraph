    // ���ػ����ĵ�ɫ����ɫ
    function loadArtifactColors() {
        allArtifacts.forEach(artifact => {
            const colorsDiv = document.getElementById(`colors-${artifact.id}`);
            if (colorsDiv && artifact.color_palette) {
                const palette = artifact.color_palette;
                if (palette && Array.isArray(palette)) {
                    const colors = palette.map(item => {
                        if (typeof item === 'string') {
                            return item;
                        } else if (typeof item === 'object' && item.hex) {
                            return item.hex;
                        }
                        return null;
                    }).filter(c => c !== null).slice(0, 8); // �����ʾ8����ɫ

                    colors.forEach(color => {
                        const dot = document.createElement('div');
                        dot.className = 'color-dot';
                        dot.style.backgroundColor = color;
                        dot.title = color;
                        colorsDiv.appendChild(dot);
                    });
                }
            }
        });
        console.log('�Ѽ���', allArtifacts.length, '�������ĵ�ɫ��');
    }

