        window.location.search = urlParams.toString();
    }

    // ���㻭��������ˮƽ�����ϵ�λ�ã�0~1��
    function computeArtifactFocusX(image) {
        try {
            const sampleWidth = 120;
            const sampleHeight = Math.max(60, Math.round(sampleWidth * image.height / image.width));

            const canvas = document.createElement('canvas');
            canvas.width = sampleWidth;
            canvas.height = sampleHeight;
            const ctx = canvas.getContext('2d');

            ctx.drawImage(image, 0, 0, sampleWidth, sampleHeight);
            const data = ctx.getImageData(0, 0, sampleWidth, sampleHeight).data;

            const columnScore = new Array(sampleWidth).fill(0);

            for (let x = 1; x < sampleWidth; x++) {
                for (let y = 0; y < sampleHeight; y++) {
                    const idx = (y * sampleWidth + x) * 4;
                    const r = data[idx];
                    const g = data[idx + 1];
                    const b = data[idx + 2];
                    const lum = 0.299 * r + 0.587 * g + 0.114 * b;

                    const idxLeft = idx - 4;
                    const r2 = data[idxLeft];
                    const g2 = data[idxLeft + 1];
                    const b2 = data[idxLeft + 2];
                    const lum2 = 0.299 * r2 + 0.587 * g2 + 0.114 * b2;

                    columnScore[x] += Math.abs(lum - lum2);
                }
            }

            let maxScore = 0;
            for (let i = 0; i < sampleWidth; i++) {
                if (columnScore[i] > maxScore) maxScore = columnScore[i];
            }
            if (maxScore <= 0) {
                return 0.5;
            }

            let total = 0;
            let weighted = 0;
            const threshold = maxScore * 0.3;
            for (let x = 0; x < sampleWidth; x++) {
                const s = Math.max(0, columnScore[x] - threshold);
                total += s;
                weighted += s * x;
            }

            if (total <= 0) {
                return 0.5;
            }

            const focus = weighted / total;
            return focus / (sampleWidth - 1);
        } catch (e) {
            console.error('���㻭������λ��ʧ��:', e);
            return 0.5;
        }
    }

    // ѡ����
    function selectArtifact(artifactId) {
        console.log('ѡ����, ID:', artifactId);
        // �Ƴ�֮ǰ��ѡ��
        document.querySelectorAll('.artifact-card').forEach(card => {
            card.classList.remove('selected');
        });

        // �����µ�ѡ��
        const card = document.querySelector(`.artifact-card[data-id="${artifactId}"]`);
        console.log('�ҵ��Ŀ�Ƭ:', card);
        if (card) {
            card.classList.add('selected');
        }

        selectedArtifact = allArtifacts.find(a => String(a.id) === String(artifactId));
        console.log('ѡ�еĻ���:', selectedArtifact);

        // ���ػ���ͼƬ��������ӳ��
        if (selectedArtifact) {
            let imageUrl = '';
            // ���ӽ�׳��ͼƬ·������
            const imgPath = selectedArtifact.image || '';
            const extImgPath = selectedArtifact.external_image || '';
            
            if (imgPath.startsWith('http') || imgPath.startsWith('/')) {
                imageUrl = imgPath;
            } else if (imgPath) {
                // �������·����ȷ�����ظ����� static
                const staticPrefix = '{% static "" %}';
                imageUrl = staticPrefix + imgPath;
            } else if (extImgPath) {
                imageUrl = extImgPath;
            }

            console.log('�������ͼƬURL:', imageUrl);

            if (imageUrl) {
                const img = new Image();
                img.crossOrigin = "Anonymous";
                img.onload = function() {
                    console.log('����ͼƬ���سɹ�:', imageUrl);
                    selectedArtifactImage = img; // ֻ�м��سɹ��Ÿ�ֵ
                    selectedArtifactFocusX = computeArtifactFocusX(img);
                    console.log('���������λ��X(0~1):', selectedArtifactFocusX);
                    updateDesignPreview();
                    update3DModel();
                };
                img.onerror = function() {
                    console.error('����ͼƬ����ʧ��:', imageUrl);
                    selectedArtifactImage = null;
                    updateDesignPreview(); // ʧ��ҲҪ�ػ棨���˵���ɫ��
                    update3DModel();
                };
                img.src = imageUrl;
            } else {
                console.log('����ЧͼƬURL');
                selectedArtifactImage = null;
                updateDesignPreview();
                update3DModel();
            }
        } else {
            selectedArtifactImage = null;
            updateDesignPreview();
            update3DModel();
        }
    }

    // �л��Ա�
    function switchGender(gender) {
        console.log('�л��Ա�:', gender);
        selectedGender = gender;

        // ���°�ť״̬
        document.getElementById('gender-male').classList.remove('active');
        document.getElementById('gender-female').classList.remove('active');
        document.getElementById(`gender-${gender}`).classList.add('active');

        // ���ض�Ӧ�ķ�װ
        const garments = gender === 'male' ? maleGarments : femaleGarments;
        const grid = document.getElementById('garment-grid');
        grid.innerHTML = '';

                garments.forEach(garment => {
                    const card = document.createElement('div');
                    card.className = 'garment-card';
                    card.dataset.id = garment.id;
                    
                    // ����Ψһ��onclick��������
                    card.setAttribute('onclick', `selectGarment(${garment.id})`);
                    
                    // ����CanvasԤ����װ����
                    const canvas = document.createElement('canvas');
                    canvas.width = 80;
                    canvas.height = 100;
                    canvas.style.borderRadius = '4px';
                    canvas.style.marginBottom = '8px';
                    canvas.style.backgroundColor = selectedBackgroundColor;
                    
                    const ctx = canvas.getContext('2d');
                    drawGarmentThumbnail(ctx, garment.id, selectedGender, selectedBackgroundColor);
                    
                    card.appendChild(canvas);
                    
                    const nameDiv = document.createElement('div');
                    nameDiv.style.fontWeight = 'bold';
                    nameDiv.style.fontSize = '12px';
                    nameDiv.textContent = garment.name;
                    
                    const descDiv = document.createElement('div');
                    descDiv.style.fontSize = '10px';
                    descDiv.style.color = '#666';
                    descDiv.style.marginTop = '2px';
                    descDiv.textContent = garment.description || '';
                    
                    card.appendChild(nameDiv);
                    card.appendChild(descDiv);
                    grid.appendChild(card);
                    // ���ÿ�Ƭ����ɫ
                    card.style.backgroundColor = selectedBackgroundColor;
                });

        selectedGarmentType = null;
        
        // �Զ�ѡ���һ����װ����ɫ�����汾��
        if (garments.length > 0) {
            setTimeout(() => {
                selectGarment(garments[0].id);
            }, 10);
        }
    }

    // ѡ���װ - �޸���ʽ�л�����
    function selectGarment(garmentId) {
        console.log('ѡ���װ, ID:', garmentId);
        
        // �Ƴ�����ѡ��״̬
        document.querySelectorAll('.garment-card').forEach(card => {
            card.classList.remove('selected');
        });

        // �ҵ�ѡ�еķ�װ
        const garments = selectedGender === 'male' ? maleGarments : femaleGarments;
        selectedGarmentType = garments.find(g => String(g.id) === String(garmentId));
        console.log('ѡ�еķ�װ:', selectedGarmentType);

        // ����ѡ��״̬
        const card = document.querySelector(`.garment-card[data-id="${garmentId}"]`);
        if (card) {
            card.classList.add('selected');
            
            // ��������Ԥ�� - ���ǹؼ��޸���
            setTimeout(() => {
                updateDesignPreview();
                update3DModel();
            }, 100);
        } else {
            console.log('δ�ҵ���װ��Ƭ:', garmentId);
        }
    }

    // �������Ԥ�� - �޸���ʽ���仯����
    function updateDesignPreview() {
        if (!selectedGarmentType) {
            console.log('ȱ�ٷ�װ��ʽ');
            return;
        }

        console.log('����Ԥ��:', selectedGarmentType.name, '�Ա�:', selectedGender);

        const canvas = document.getElementById('design-canvas');
        const ctx = canvas.getContext('2d');

        canvas.width = canvas.offsetWidth;
        canvas.height = canvas.offsetHeight;

        // ��ջ���
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        // ��ȡ�����ĵ�ɫ�壬���û��ѡ�еĻ�����ʹ�ð�ɫ��δ��ɫ������װ��
        let colors = [selectedBackgroundColor]; // ʹ���û�ѡ��ı���ɫ��ΪĬ��
        if (selectedArtifact && selectedArtifact.color_palette) {
            const palette = selectedArtifact.color_palette;
            if (Array.isArray(palette) && palette.length > 0) {
                const artifactColors = palette.map(item => {
                    if (typeof item === 'string') return item;
                    if (typeof item === 'object' && item.hex) return item.hex;
                    return '#999';
                }).slice(0, 6);
                // ��������ɫ���ӵ�����ɫ֮��
                colors = [selectedBackgroundColor, ...artifactColors];
            }
        }

        // ����ѡ��Ŀ�ʽ���Ʋ�ͬ�ķ�װ - ���ǹؼ��޸���
        drawGarment(ctx, canvas.width, canvas.height, colors, selectedGender, selectedGarmentType.name, selectedGarmentType.id, selectedArtifactImage);
    }

    // ���Ʒ�װ - ���ݿ�ʽID���Ʋ�ͬ��װ
    function drawGarment(ctx, width, height, colors, gender, garmentName, garmentId, artifactImage) {
        const centerX = width / 2;
        const centerY = height / 2;

        // ���ƽ��䱳��
        const gradient = ctx.createLinearGradient(0, 0, width, height);
        gradient.addColorStop(0, '#FAF8F5');
        gradient.addColorStop(1, '#E8E2D5');
        ctx.fillStyle = gradient;
        ctx.fillRect(0, 0, width, height);

        ctx.strokeStyle = '#2C3E50';
        ctx.lineWidth = 2.5;
        ctx.lineCap = 'round';
        ctx.lineJoin = 'round';

        ctx.beginPath();

        if (gender === 'male') {
            // ���Է�װ - ����ID���ֲ�ͬ��ʽ
            switch(parseInt(garmentId)) {
                case 1: // T�� - Բ����䣨�Ŵ������ͼ��״��
                    // ��� - ����ȥ��Բ��
                    ctx.moveTo(centerX - 72, centerY - 128);
                    ctx.lineTo(centerX - 40, centerY - 128);
                    ctx.quadraticCurveTo(centerX, centerY - 104, centerX + 40, centerY - 128);
                    ctx.lineTo(centerX + 72, centerY - 128);
                    // �Ҽ�
                    ctx.lineTo(centerX + 88, centerY - 112);
                    // ���� - ����
                    ctx.lineTo(centerX + 152, centerY - 100);
                    ctx.lineTo(centerX + 152, centerY - 40);
                    ctx.lineTo(centerX + 88, centerY - 48);
                    // �Ҳ�����
                    ctx.lineTo(centerX + 80, centerY + 120);
                    // �ײ�
                    ctx.lineTo(centerX - 80, centerY + 120);
                    // �������
                    ctx.lineTo(centerX - 88, centerY - 48);
                    // ���� - ����
                    ctx.lineTo(centerX - 152, centerY - 40);
                    ctx.lineTo(centerX - 152, centerY - 100);
                    ctx.lineTo(centerX - 88, centerY - 112);
                    // ���
                    ctx.lineTo(centerX - 72, centerY - 128);
                    ctx.closePath();
                    break;

                case 2: // ��ʽ���� - ������ʽ�������Ŵ������ͼ��״��
                    // ���� - ���Ե�С����
                    ctx.moveTo(centerX - 32, centerY - 140);
                    ctx.lineTo(centerX + 32, centerY - 140);
                    ctx.lineTo(centerX + 24, centerY - 112);
                    ctx.lineTo(centerX - 24, centerY - 112);
                    ctx.closePath();

                    // ����·����·�����
                    ctx.moveTo(centerX - 60, centerY - 112);
                    ctx.lineTo(centerX + 60, centerY - 112);
                    // �Ҳ���������
                    ctx.lineTo(centerX + 72, centerY - 80);
                    ctx.lineTo(centerX + 88, centerY + 20);
                    ctx.lineTo(centerX + 72, centerY + 100);
                    ctx.lineTo(centerX + 88, centerY + 160);
                    // �ײ� - ��΢չ���ĵװ�
                    ctx.lineTo(centerX - 88, centerY + 160);
                    // �����������
                    ctx.lineTo(centerX - 72, centerY + 100);
                    ctx.lineTo(centerX - 88, centerY + 20);
                    ctx.lineTo(centerX - 72, centerY - 80);
                    ctx.lineTo(centerX - 60, centerY - 112);
                    ctx.closePath();

                    // ���� - �ϳ�������
                    ctx.moveTo(centerX + 72, centerY - 60);
                    ctx.lineTo(centerX + 152, centerY - 60);
                    ctx.lineTo(centerX + 152, centerY + 32);
                    ctx.lineTo(centerX + 88, centerY + 32);
                    ctx.closePath();

                    // ����
                    ctx.moveTo(centerX - 72, centerY - 60);
                    ctx.lineTo(centerX - 152, centerY - 60);
                    ctx.lineTo(centerX - 152, centerY + 32);
                    ctx.lineTo(centerX - 88, centerY + 32);
                    ctx.closePath();

                    // ���� - �����·���ʼ
                    ctx.moveTo(centerX, centerY - 112);
                    ctx.lineTo(centerX, centerY + 160);

                    // �̿� - 2���ۣ̿������Ե�װ��
                    ctx.beginPath();
                    ctx.arc(centerX, centerY - 32, 6, 0, Math.PI * 2);
                    ctx.arc(centerX, centerY + 32, 6, 0, Math.PI * 2);
                    ctx.stroke();
                    break;

                case 3: // ��װ���� - ������װ���Ŵ������ͼ��״��
                    // ���
                    ctx.moveTo(centerX - 72, centerY - 128);
                    ctx.lineTo(centerX + 72, centerY - 128);
                    // �Ҳ�
                    ctx.lineTo(centerX + 88, centerY - 88);
                    ctx.lineTo(centerX + 112, centerY + 20);
                    ctx.lineTo(centerX + 80, centerY + 140);
                    ctx.lineTo(centerX + 100, centerY + 180);
                    // �ײ�
                    ctx.lineTo(centerX - 100, centerY + 180);
                    // ���
                    ctx.lineTo(centerX - 80, centerY + 140);
                    ctx.lineTo(centerX - 112, centerY + 20);
                    ctx.lineTo(centerX - 88, centerY - 88);
                    ctx.lineTo(centerX - 72, centerY - 128);
                    ctx.closePath();

                    // ����
                    ctx.moveTo(centerX + 88, centerY - 72);
                    ctx.lineTo(centerX + 160, centerY - 72);
                    ctx.lineTo(centerX + 160, centerY + 40);
                    ctx.lineTo(centerX + 96, centerY + 40);
                    ctx.closePath();

                    // ����
                    ctx.moveTo(centerX - 88, centerY - 72);
                    ctx.lineTo(centerX - 160, centerY - 72);
                    ctx.lineTo(centerX - 160, centerY + 40);
                    ctx.lineTo(centerX - 96, centerY + 40);
                    ctx.closePath();

                    // ����
                    ctx.moveTo(centerX, centerY - 128);
                    ctx.lineTo(centerX, centerY + 180);
                    break;

                case 4: // �������� - ����+���ӣ��Ŵ������ͼ��״��
                    // �������
                    ctx.moveTo(centerX - 40, centerY - 152);
                    ctx.lineTo(centerX + 40, centerY - 152);
                    // �Ҳ�����
                    ctx.lineTo(centerX + 60, centerY - 112);
                    ctx.lineTo(centerX + 72, centerY - 20);
                    ctx.lineTo(centerX + 48, centerY + 48);
                    ctx.lineTo(centerX + 60, centerY + 80);
                    // �ײ�
                    ctx.lineTo(centerX - 60, centerY + 80);
                    // �������
                    ctx.lineTo(centerX - 48, centerY + 48);
                    ctx.lineTo(centerX - 72, centerY - 20);
                    ctx.lineTo(centerX - 60, centerY - 112);
                    ctx.lineTo(centerX - 40, centerY - 152);
                    ctx.closePath();

                    // ����
                    ctx.moveTo(centerX + 60, centerY - 100);
                    ctx.lineTo(centerX + 128, centerY - 100);
                    ctx.lineTo(centerX + 128, centerY - 20);
                    ctx.lineTo(centerX + 68, centerY - 20);
                    ctx.closePath();

                    // ����
                    ctx.moveTo(centerX - 60, centerY - 100);
                    ctx.lineTo(centerX - 128, centerY - 100);
                    ctx.lineTo(centerX - 128, centerY - 20);
                    ctx.lineTo(centerX - 68, centerY - 20);
                    ctx.closePath();

                    // �����
                    ctx.moveTo(centerX - 32, centerY + 80);
                    ctx.lineTo(centerX - 48, centerY + 168);
                    ctx.lineTo(centerX - 16, centerY + 168);
                    ctx.lineTo(centerX - 8, centerY + 80);
                    ctx.closePath();

                    // �ҿ���
                    ctx.moveTo(centerX + 32, centerY + 80);
                    ctx.lineTo(centerX + 48, centerY + 168);
                    ctx.lineTo(centerX + 16, centerY + 168);
                    ctx.lineTo(centerX + 8, centerY + 80);
                    ctx.closePath();
                    break;
            }
        } else {
            // Ů�Է�װ - ����ID���ֲ�ͬ��ʽ
            switch(parseInt(garmentId)) {
                case 4: // T�� - Ů��Բ����䣨�Ŵ������ͼ��״��
                    // ��� - ����ȥ��Բ��
                    ctx.moveTo(centerX - 64, centerY - 128);
                    ctx.lineTo(centerX - 36, centerY - 128);
                    ctx.quadraticCurveTo(centerX, centerY - 108, centerX + 36, centerY - 128);
                    ctx.lineTo(centerX + 64, centerY - 128);
                    // �Ҽ�
                    ctx.lineTo(centerX + 80, centerY - 112);
                    // ���� - ����
                    ctx.lineTo(centerX + 140, centerY - 100);
                    ctx.lineTo(centerX + 140, centerY - 40);
                    ctx.lineTo(centerX + 80, centerY - 48);
                    // �Ҳ����� - ������
                    ctx.lineTo(centerX + 72, centerY + 112);
                    // �ײ�
                    ctx.lineTo(centerX - 72, centerY + 112);
                    // ������� - ������
                    ctx.lineTo(centerX - 80, centerY - 48);
                    // ���� - ����
                    ctx.lineTo(centerX - 140, centerY - 40);
                    ctx.lineTo(centerX - 140, centerY - 100);
                    ctx.lineTo(centerX - 80, centerY - 112);
                    // ���
                    ctx.lineTo(centerX - 64, centerY - 128);
                    ctx.closePath();
                    break;

                case 5: // ���� - �������ۣ��Ŵ������ͼ��״��
                    // ���
                    ctx.moveTo(centerX - 40, centerY - 160);
                    ctx.lineTo(centerX + 40, centerY - 160);
                    // �Ҳ���������
                    ctx.lineTo(centerX + 48, centerY - 140);
                    ctx.lineTo(centerX + 56, centerY - 80);
                    ctx.lineTo(centerX + 48, centerY);
                    ctx.lineTo(centerX + 40, centerY + 80);
                    ctx.lineTo(centerX + 32, centerY + 160);
                    ctx.lineTo(centerX + 24, centerY + 180);
                    // �ײ�
                    ctx.lineTo(centerX - 24, centerY + 180);
                    // �����������
                    ctx.lineTo(centerX - 32, centerY + 160);
                    ctx.lineTo(centerX - 40, centerY + 80);
                    ctx.lineTo(centerX - 48, centerY);
                    ctx.lineTo(centerX - 56, centerY - 80);
                    ctx.lineTo(centerX - 48, centerY - 140);
                    ctx.lineTo(centerX - 40, centerY - 160);
                    ctx.closePath();

                    // �Ҽ��
                    ctx.moveTo(centerX + 40, centerY - 152);
                    ctx.lineTo(centerX + 48, centerY - 160);
                    ctx.lineTo(centerX + 40, centerY - 120);

                    // ����
                    ctx.moveTo(centerX - 40, centerY - 152);
                    ctx.lineTo(centerX - 48, centerY - 160);
                    ctx.lineTo(centerX - 40, centerY - 120);

                    // ����
                    ctx.moveTo(centerX, centerY - 160);
                    ctx.lineTo(centerX, centerY + 80);
                    break;

                case 6: // �������� - ������ƣ��Ŵ������ͼ��״��
                    // ���V�� - �����V��
                    ctx.moveTo(centerX - 60, centerY - 140);
                    ctx.lineTo(centerX, centerY - 72);
                    ctx.lineTo(centerX + 60, centerY - 140);
                    // �Ҳ�
                    ctx.lineTo(centerX + 72, centerY - 100);
                    ctx.lineTo(centerX + 80, centerY - 32);
                    ctx.lineTo(centerX + 60, centerY + 72);
                    ctx.lineTo(centerX + 48, centerY + 140);
                    // �ײ�
                    ctx.lineTo(centerX - 48, centerY + 140);
                    // ���
                    ctx.lineTo(centerX - 60, centerY + 72);
                    ctx.lineTo(centerX - 80, centerY - 32);
                    ctx.lineTo(centerX - 72, centerY - 100);
                    ctx.lineTo(centerX - 60, centerY - 140);
                    ctx.closePath();

                    // �ҿ��� - ���������Ե�����
                    ctx.moveTo(centerX + 72, centerY - 80);
                    ctx.lineTo(centerX + 160, centerY - 80);
                    ctx.lineTo(centerX + 160, centerY + 40);
                    ctx.lineTo(centerX + 72, centerY + 20);
                    ctx.closePath();

                    // �����
                    ctx.moveTo(centerX - 72, centerY - 80);
                    ctx.lineTo(centerX - 160, centerY - 80);
                    ctx.lineTo(centerX - 160, centerY + 40);
                    ctx.lineTo(centerX - 72, centerY + 20);
                    ctx.closePath();

                    // �����װ���� - V������ڲ�
                    ctx.moveTo(centerX - 40, centerY - 120);
                    ctx.lineTo(centerX, centerY - 72);
                    ctx.lineTo(centerX + 40, centerY - 120);
                    break;

                case 7: // ����ȹװ - ����+��ȹ�ڣ��Ŵ������ͼ��״��
                    // �������
                    ctx.moveTo(centerX - 40, centerY - 152);
                    ctx.lineTo(centerX + 40, centerY - 152);
                    // �Ҳ�
                    ctx.lineTo(centerX + 48, centerY - 112);
                    ctx.lineTo(centerX + 60, centerY - 40);
                    ctx.lineTo(centerX + 40, centerY + 32);
                    ctx.lineTo(centerX + 32, centerY + 72);
                    // �ײ�
                    ctx.lineTo(centerX - 32, centerY + 72);
                    // ���
                    ctx.lineTo(centerX - 40, centerY + 32);
                    ctx.lineTo(centerX - 60, centerY - 40);
                    ctx.lineTo(centerX - 48, centerY - 112);
                    ctx.lineTo(centerX - 40, centerY - 152);
                    ctx.closePath();

                    // ����
                    ctx.moveTo(centerX + 48, centerY - 100);
                    ctx.lineTo(centerX + 120, centerY - 100);
                    ctx.lineTo(centerX + 120, centerY - 32);
                    ctx.lineTo(centerX + 56, centerY - 32);
                    ctx.closePath();

                    // ����
                    ctx.moveTo(centerX - 48, centerY - 100);
                    ctx.lineTo(centerX - 120, centerY - 100);
                    ctx.lineTo(centerX - 120, centerY - 32);
                    ctx.lineTo(centerX - 56, centerY - 32);
                    ctx.closePath();

                    // ȹ�� - ��㲨���Σ�������
                    // ��һ�㣨�����
                    ctx.moveTo(centerX - 112, centerY + 72);
                    ctx.quadraticCurveTo(centerX - 140, centerY + 128, centerX - 112, centerY + 144);
                    ctx.lineTo(centerX + 112, centerY + 144);
                    ctx.quadraticCurveTo(centerX + 140, centerY + 128, centerX + 112, centerY + 72);
                    ctx.closePath();

                    // �ڶ���
                    ctx.moveTo(centerX - 88, centerY + 144);
                    ctx.quadraticCurveTo(centerX - 112, centerY + 160, centerX - 88, centerY + 176);
                    ctx.lineTo(centerX + 88, centerY + 176);
                    ctx.quadraticCurveTo(centerX + 112, centerY + 160, centerX + 88, centerY + 144);
                    ctx.closePath();

                    // ������
                    ctx.moveTo(centerX - 64, centerY + 176);
                    ctx.quadraticCurveTo(centerX - 80, centerY + 184, centerX - 64, centerY + 192);
                    ctx.lineTo(centerX + 64, centerY + 192);
                    ctx.quadraticCurveTo(centerX + 80, centerY + 184, centerX + 64, centerY + 176);
                    ctx.closePath();

                    // ȹ��������
                    ctx.moveTo(centerX - 40, centerY + 72);
                    ctx.quadraticCurveTo(centerX - 36, centerY + 128, centerX - 32, centerY + 176);
                    ctx.moveTo(centerX, centerY + 72);
                    ctx.quadraticCurveTo(centerX, centerY + 136, centerX, centerY + 188);
                    ctx.moveTo(centerX + 40, centerY + 72);
                    ctx.quadraticCurveTo(centerX + 36, centerY + 128, centerX + 32, centerY + 176);
                    break;

                case 8: // ��װȹ��װ - ����+A��ȹ���Ŵ������ͼ��״��
                    // ��� - СV�Σ�������
                    ctx.moveTo(centerX - 40, centerY - 120);
                    ctx.lineTo(centerX, centerY - 88);
                    ctx.lineTo(centerX + 40, centerY - 120);
                    // �Ҳ�
                    ctx.lineTo(centerX + 56, centerY - 80);
                    ctx.lineTo(centerX + 64, centerY - 32);
                    ctx.lineTo(centerX + 48, centerY + 32);
                    ctx.lineTo(centerX + 40, centerY + 48);
                    // �ײ� - ���½���
                    ctx.lineTo(centerX - 40, centerY + 48);
                    // ���
                    ctx.lineTo(centerX - 48, centerY + 32);
                    ctx.lineTo(centerX - 64, centerY - 32);
                    ctx.lineTo(centerX - 56, centerY - 80);
                    ctx.lineTo(centerX - 40, centerY - 120);
                    ctx.closePath();

                    // ����
                    ctx.moveTo(centerX + 56, centerY - 72);
                    ctx.lineTo(centerX + 120, centerY - 72);
                    ctx.lineTo(centerX + 120, centerY + 8);
                    ctx.lineTo(centerX + 64, centerY + 8);
                    ctx.closePath();

                    // ����
                    ctx.moveTo(centerX - 56, centerY - 72);
                    ctx.lineTo(centerX - 120, centerY - 72);
                    ctx.lineTo(centerX - 120, centerY + 8);
                    ctx.lineTo(centerX - 64, centerY + 8);
                    ctx.closePath();

                    // ���Ե�A��ȹ - �����·��ֿ���������ȹ��
                    ctx.moveTo(centerX - 96, centerY + 48);
                    ctx.quadraticCurveTo(centerX - 128, centerY + 104, centerX - 96, centerY + 152);
                    ctx.lineTo(centerX + 96, centerY + 152);
                    ctx.quadraticCurveTo(centerX + 128, centerY + 104, centerX + 96, centerY + 48);
                    ctx.closePath();

                    // ȹ�ڵڶ���
                    ctx.moveTo(centerX - 72, centerY + 152);
                    ctx.quadraticCurveTo(centerX - 88, centerY + 176, centerX - 72, centerY + 192);
                    ctx.lineTo(centerX + 72, centerY + 192);
                    ctx.quadraticCurveTo(centerX + 88, centerY + 176, centerX + 72, centerY + 152);
                    ctx.closePath();

                    // ȹ��������
                    ctx.moveTo(centerX - 32, centerY + 48);
                    ctx.quadraticCurveTo(centerX - 24, centerY + 124, centerX - 16, centerY + 192);
                    ctx.moveTo(centerX, centerY + 48);
                    ctx.quadraticCurveTo(centerX, centerY + 132, centerX, centerY + 196);
                    ctx.moveTo(centerX + 32, centerY + 48);
                    ctx.quadraticCurveTo(centerX + 24, centerY + 124, centerX + 16, centerY + 192);
                    break;
            }
        }

        if (artifactImage) {
            ctx.save();
            ctx.clip();

            let contentBox = { x: 0, y: 0, w: artifactImage.width, h: artifactImage.height };
            let domColor = '#f5f5f5';
            
            try {
                contentBox = computeArtifactContentBounds(artifactImage);
                if (contentBox.w < 50 || contentBox.h < 50) {
                    contentBox = { x: 0, y: 0, w: artifactImage.width, h: artifactImage.height };
                }
            } catch (e) {
                console.warn('Smart Mapping analysis failed, using defaults:', e);
            }

            let subjectBox = contentBox;
            try {
                subjectBox = computeMainSubjectBounds(artifactImage, contentBox);
            } catch (e) {
                console.warn('Main subject analysis failed, fallback to content box:', e);
            }

            try {
                domColor = getDominantColor(
                    artifactImage,
                    subjectBox.x,
                    subjectBox.y,
                    subjectBox.w,
                    subjectBox.h
                );
            } catch (e) {
                console.warn('Dominant color from subject failed, using defaults:', e);
            }

            ctx.fillStyle = domColor;
            ctx.fillRect(0, 0, width, height);

            const sx = subjectBox.x;
            const sy = subjectBox.y;
            const sw = subjectBox.w;
            const sh = subjectBox.h;

            const designBounds = getGarmentDesignBounds(width, height, gender, garmentId);

            const subjectScale = 0.9;
            const usableW = designBounds.w * subjectScale;
            const usableH = designBounds.h * subjectScale;

            const imgAspect = sw / sh;
            const targetAspect = usableW / usableH;

            let paintW;
            let paintH;
            if (imgAspect > targetAspect) {
                paintW = usableW;
                paintH = paintW / imgAspect;
            } else {
                paintH = usableH;
                paintW = paintH * imgAspect;
            }

            const paintX = designBounds.x + (designBounds.w - paintW) / 2;
            const paintY = designBounds.y + (designBounds.h - paintH) / 2;

            mapArtifactToGarmentGrid(
                ctx,
                artifactImage,
                subjectBox,
                paintX,
                paintY,
                paintW,
                paintH,
                40,
                40
            );

            const marginLeft = paintX - designBounds.x;
            if (marginLeft > 1) {
                const stripW = Math.max(1, sw * 0.2);
                ctx.drawImage(
                    artifactImage,
                    sx,
                    sy,
                    stripW,
                    sh,
                    designBounds.x,
                    paintY,
                    marginLeft,
                    paintH
                );
            }

            const marginRight = (designBounds.x + designBounds.w) - (paintX + paintW);
            if (marginRight > 1) {
                const stripW = Math.max(1, sw * 0.2);
                ctx.drawImage(
                    artifactImage,
                    sx + sw - stripW,
                    sy,
                    stripW,
                    sh,
                    paintX + paintW,
                    paintY,
                    marginRight,
                    paintH
                );
            }

            const marginTop = paintY - designBounds.y;
            if (marginTop > 1) {
                const stripH = Math.max(1, sh * 0.2);
                ctx.drawImage(
                    artifactImage,
                    sx,
                    sy,
                    sw,
                    stripH,
                    paintX,
                    designBounds.y,
                    paintW,
                    marginTop
                );
            }

            const marginBottom = (designBounds.y + designBounds.h) - (paintY + paintH);
            if (marginBottom > 1) {
                const stripH = Math.max(1, sh * 0.2);
                ctx.drawImage(
                    artifactImage,
                    sx,
                    sy + sh - stripH,
                    sw,
                    stripH,
                    paintX,
                    paintY + paintH,
                    paintW,
                    marginBottom
                );
            }

            ctx.restore();

        } else if (colors.length > 0) {
            const mainColor = colors[0];
            ctx.fillStyle = mainColor;
            ctx.fill();
        }

        if (!artifactImage) {
            ctx.strokeStyle = colors[1] || '#D4AF37';
            ctx.lineWidth = 1;
            ctx.stroke();

            // װ��ͼ�� - ʹ�û���ɫ��
            if (colors.length > 1) {
                // ��һ��װ��
                ctx.fillStyle = colors[1] || '#B8860B';
                ctx.globalAlpha = 0.6;
                
                if (gender === 'male') {
                    // ���Է�װ���̿�װ��
                    ctx.beginPath();
                    ctx.arc(centerX, centerY - 100, 8, 0, Math.PI * 2);
                    ctx.fill();
                    
                    ctx.beginPath();
                    ctx.arc(centerX - 30, centerY - 60, 5, 0, Math.PI * 2);
                    ctx.fill();
                    
                    ctx.beginPath();
                    ctx.arc(centerX + 30, centerY - 60, 5, 0, Math.PI * 2);
                    ctx.fill();
                } else {
                    // Ů�����۵Ļ���װ��
                    ctx.beginPath();
                    ctx.ellipse(centerX, centerY + 50, 15, 8, 0, 0, Math.PI * 2);
                    ctx.fill();
                    
                    ctx.beginPath();
                    ctx.ellipse(centerX - 20, centerY + 80, 8, 12, 0, 0, Math.PI * 2);
                    ctx.fill();
                    
                    ctx.beginPath();
                    ctx.ellipse(centerX + 20, centerY + 80, 8, 12, 0, 0, Math.PI * 2);
                    ctx.fill();
                }
                ctx.globalAlpha = 1.0;
            }

            // �ڶ���װ��
            if (colors.length > 2) {
                ctx.strokeStyle = colors[2] || '#DAA520';
                ctx.lineWidth = 1.5;
                ctx.globalAlpha = 0.7;
                
                if (gender === 'male') {
                    // ���Է�װ������װ��
                    ctx.beginPath();
                    ctx.moveTo(centerX - 60, centerY - 40);
                    ctx.lineTo(centerX + 60, centerY - 40);
                    ctx.stroke();
                    
                    ctx.beginPath();
                    ctx.moveTo(centerX - 50, centerY + 40);
                    ctx.lineTo(centerX + 50, centerY + 40);
                    ctx.stroke();
                } else {
                    // Ů�����۵�����װ�Σ����ܱ����ɡ�Ц�����Ĳ��֣�
                    // ֱ��ȡ���������������Ч��
                }
                ctx.globalAlpha = 1.0;
            }
        }

        // ���ӱ�������
        ctx.fillStyle = '#2C3E50';
        ctx.font = 'bold 16px Microsoft YaHei, sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText(garmentName, centerX, 30);
        
        ctx.font = '12px Microsoft YaHei, sans-serif';
        ctx.fillStyle = '#7F8C8D';
        ctx.fillText('��ͳ���� �� �ִ�����', centerX, height - 20);
    }

    function getGarmentDesignBounds(width, height, gender, garmentId) {
        const id = parseInt(garmentId);

        let marginX;
        let marginTop;
        let marginBottom;

        if (gender === 'female') {
            switch (id) {
                case 5:
                    marginX = width * 0.1;
                    marginTop = height * 0.12;
                    marginBottom = height * 0.14;
                    break;
                case 7:
                    marginX = width * 0.1;
                    marginTop = height * 0.12;
                    marginBottom = height * 0.16;
                    break;
                case 8:
                    marginX = width * 0.1;
                    marginTop = height * 0.1;
                    marginBottom = height * 0.18;
                    break;
                default:
                    marginX = width * 0.1;
                    marginTop = height * 0.12;
                    marginBottom = height * 0.16;
                    break;
            }
        } else {
            switch (id) {
                case 2:
                case 3:
                    marginX = width * 0.1;
                    marginTop = height * 0.14;
                    marginBottom = height * 0.16;
                    break;
                default:
                    marginX = width * 0.1;
                    marginTop = height * 0.12;
                    marginBottom = height * 0.16;
                    break;
            }
        }

        const w = width - marginX * 2;
        const h = height - marginTop - marginBottom;
        const x = marginX;
        const y = marginTop;

        return { x, y, w, h };
    }

    function mapArtifactToGarmentGrid(ctx, img, contentBox, dstX, dstY, dstW, dstH, rows, cols) {
        const sx0 = contentBox.x;
        const sy0 = contentBox.y;
        const sw = contentBox.w;
        const sh = contentBox.h;

        const cellW = dstW / cols;
        const cellH = dstH / rows;
        const srcCellW = sw / cols;
        const srcCellH = sh / rows;

        for (let r = 0; r < rows; r++) {
            const sy = sy0 + r * srcCellH;
            const ty = dstY + r * cellH;

            for (let c = 0; c < cols; c++) {
                const sx = sx0 + c * srcCellW;
                const tx = dstX + c * cellW;

                ctx.drawImage(
                    img,
                    sx,
                    sy,
                    srcCellW,
                    srcCellH,
                    tx,
                    ty,
                    cellW,
                    cellH
                );
            }
        }
    }

    // ���ܼ��㻭���������������������ڽ�һ���ҡ����塱��
    function computeMainSubjectBounds(img, contentBox) {
        const canvas = document.createElement('canvas');
        const w = Math.max(1, Math.round(contentBox.w));
        const h = Math.max(1, Math.round(contentBox.h));
        canvas.width = w;
        canvas.height = h;
        const ctx = canvas.getContext('2d');

        ctx.drawImage(
            img,
            contentBox.x,
            contentBox.y,
            contentBox.w,
            contentBox.h,
            0,
            0,
            w,
            h
        );

        const imageData = ctx.getImageData(0, 0, w, h);
        const data = imageData.data;

        let rSum = 0;
        let gSum = 0;
        let bSum = 0;
        let count = 0;

        for (let i = 0; i < data.length; i += 4) {
            const a = data[i + 3];
            if (a <= 10) continue;
            rSum += data[i];
            gSum += data[i + 1];
            bSum += data[i + 2];
            count++;
        }

        if (count === 0) {
            return contentBox;
        }

        const avgR = rSum / count;
        const avgG = gSum / count;
        const avgB = bSum / count;

        const diffThreshold = 45;

        let minX = w;
        let minY = h;
        let maxX = 0;
        let maxY = 0;
        let found = false;

        for (let y = 0; y < h; y++) {
            for (let x = 0; x < w; x++) {
                const i = (y * w + x) * 4;
                const a = data[i + 3];
                if (a <= 10) continue;

                const r = data[i];
                const g = data[i + 1];
                const b = data[i + 2];

                const dr = Math.abs(r - avgR);
                const dg = Math.abs(g - avgG);
                const db = Math.abs(b - avgB);
                const diff = dr + dg + db;

                if (diff > diffThreshold) {
                    if (x < minX) minX = x;
                    if (x > maxX) maxX = x;
                    if (y < minY) minY = y;
                    if (y > maxY) maxY = y;
                    found = true;
                }
            }
        }

        if (!found) {
            return contentBox;
        }

        const paddingX = Math.round(w * 0.08);

        minX = Math.max(0, minX - paddingX);
        maxX = Math.min(w - 1, maxX + paddingX);

        const subjW = Math.max(1, maxX - minX + 1);
        const subjH = h;

        const minFracW = 0.25;

        if (subjW < w * minFracW) {
            return contentBox;
        }

        return {
            x: contentBox.x + minX,
            y: contentBox.y,
            w: subjW,
            h: subjH
        };
    }

    // ���ܼ��㻭�����ݱ߽磨ȥ�ױ�/����
    function computeArtifactContentBounds(img) {
        const canvas = document.createElement('canvas');
        const w = img.width;
        const h = img.height;
        canvas.width = w;
        canvas.height = h;
        const ctx = canvas.getContext('2d');
        ctx.drawImage(img, 0, 0);
        
        const imageData = ctx.getImageData(0, 0, w, h);
        const data = imageData.data;
        
        // ��ֵ���ж��Ƿ�Ϊ�ױ�/�����������ֵ
        const whiteThreshold = 240; 
        // �ݲ�ж��Ƿ�Ϊ͸��
        const alphaThreshold = 10;

        let minX = w, minY = h, maxX = 0, maxY = 0;
        let found = false;

        // ɨ��Ѱ�ұ߽�
        for (let y = 0; y < h; y++) {
            for (let x = 0; x < w; x++) {
                const i = (y * w + x) * 4;
                const r = data[i];
                const g = data[i+1];
                const b = data[i+2];
                const a = data[i+3];

                // �ж��Ƿ�Ϊ��Ч���� (����ȫ͸�� �� �Ǹ�����ɫ/�Ұ�ɫ�߿�)
                const isWhite = r > whiteThreshold && g > whiteThreshold && b > whiteThreshold;
                if (a > alphaThreshold && !isWhite) {
                    if (x < minX) minX = x;
                    if (x > maxX) maxX = x;
                    if (y < minY) minY = y;
                    if (y > maxY) maxY = y;
                    found = true;
                }
            }
        }

        if (!found) {
            return { x: 0, y: 0, w: w, h: h };
        }

        const padding = 2;
        minX = Math.max(0, minX - padding);
        minY = Math.max(0, minY - padding);
        maxX = Math.min(w, maxX + padding);
        maxY = Math.min(h, maxY + padding);

        let boxW = maxX - minX;
        let boxH = maxY - minY;

        const insetX = Math.max(0, Math.round(boxW * 0.04));
        const insetY = Math.max(0, Math.round(boxH * 0.04));

        minX = Math.min(maxX - 1, minX + insetX);
        minY = Math.min(maxY - 1, minY + insetY);
        maxX = Math.max(minX + 1, maxX - insetX);
        maxY = Math.max(minY + 1, maxY - insetY);

        boxW = maxX - minX;
        boxH = maxY - minY;

        return {
            x: minX,
            y: minY,
            w: boxW,
            h: boxH
        };
    }

    // ��ȡ������ɫ��
    function getDominantColor(img, x, y, w, h) {
        const canvas = document.createElement('canvas');
        // ��С�ߴ��Լӿ���㣬50x50�㹻
        const scaleW = 50;
        const scaleH = 50;
        canvas.width = scaleW;
        canvas.height = scaleH;
        const ctx = canvas.getContext('2d');
        
        // ���Ʋü��������
        ctx.drawImage(img, x, y, w, h, 0, 0, scaleW, scaleH);
        
        const imageData = ctx.getImageData(0, 0, scaleW, scaleH);
        const data = imageData.data;
        let r = 0, g = 0, b = 0, count = 0;

        for (let i = 0; i < data.length; i += 4) {
            // ����͸�����غ͹������أ����⻭�����Ӱ���ɫ��
            if (data[i+3] > 10 && !(data[i] > 240 && data[i+1] > 240 && data[i+2] > 240)) {
                r += data[i];
                g += data[i+1];
                b += data[i+2];
                count++;
            }
        }

        if (count === 0) return '#f5f5f5'; // Ĭ�ϵ�ɫ

        r = Math.round(r / count);
        g = Math.round(g / count);
        b = Math.round(b / count);

        return `rgb(${r}, ${g}, ${b})`;
    }

    // 3Dģ�ͱ���
    let scene, camera, renderer, model;
    let modelInitialized = false;

    // ��ʼ��3Dģ��
    function init3DModel() {
        const container = document.getElementById('model-3d');
        const width = container.clientWidth;
        const height = container.clientHeight;

        // ��������
        scene = new THREE.Scene();
        scene.background = new THREE.Color(0x667eea);

        // �������
        camera = new THREE.PerspectiveCamera(75, width / height, 0.1, 1000);
        camera.position.z = 5;

        // ������Ⱦ��
        renderer = new THREE.WebGLRenderer({ antialias: true });
        renderer.setSize(width, height);
        container.appendChild(renderer.domElement);

        // ���ӹ�Դ
        const ambientLight = new THREE.AmbientLight(0x404040, 0.5);
        scene.add(ambientLight);

        const directionalLight = new THREE.DirectionalLight(0xffffff, 1);
        directionalLight.position.set(1, 1, 1);
        scene.add(directionalLight);

        modelInitialized = true;
        update3DModel();
    }

    // ����3Dģ��
    function update3DModel() {
        if (!modelInitialized) return;

        // �Ƴ���ģ��
        if (model) {
            scene.remove(model);
            model.geometry.dispose();
            model.material.dispose();
        }

        // �����򵥵�3D����ģ��
        const geometry = new THREE.CapsuleGeometry(0.5, 1.5, 4, 8);
        
        let material;
        
        // �����ѡ�еĻ������Ѽ���ͼƬ��ʹ��������ͼ
        if (selectedArtifactImage) {
            const texture = new THREE.Texture(selectedArtifactImage);
            texture.needsUpdate = true; // ȷ����������

            const focusX = typeof selectedArtifactFocusX === 'number' ? selectedArtifactFocusX : 0.5;
            texture.wrapS = THREE.ClampToEdgeWrapping;
            texture.wrapT = THREE.ClampToEdgeWrapping;
            texture.repeat.set(1, 1);
            texture.offset.set(Math.max(0, Math.min(focusX - 0.5, 1)), 0);
            
            material = new THREE.MeshBasicMaterial({
                map: texture
            });
        } else {
            // ȷ����ɫ�������ѡ�еĻ�������ɫ�壬ʹ�õ�һ����ɫ������ʹ�ð�ɫ��δ��ɫ������װ��
            let color = '#FFFFFF'; // Ĭ�ϰ�ɫ
            if (selectedArtifact && selectedArtifact.color_palette) {
                const palette = selectedArtifact.color_palette;
                if (Array.isArray(palette) && palette.length > 0) {
                    const firstColor = palette[0];
                    if (typeof firstColor === 'string') {
                        color = firstColor;
                    } else if (typeof firstColor === 'object' && firstColor.hex) {
                        color = firstColor.hex;
                    }
                }
            }

            material = new THREE.MeshPhongMaterial({
                color: new THREE.Color(color),
                shininess: 100
            });
        }

        model = new THREE.Mesh(geometry, material);

        // �����Ա����λ��
        if (selectedGender === 'female') {
            model.position.y = -0.5;
        } else {
            model.position.y = -0.3;
        }

        scene.add(model);
        renderer.render(scene, camera);
    }
</script>
{% endblock %}
